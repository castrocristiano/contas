# .env.example — Referência de variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o arquivo .env com valores reais.

# --- PostgreSQL ---
POSTGRES_DB=contas
POSTGRES_USER=contas
POSTGRES_PASSWORD=change_me_in_production

# --- SQLAlchemy / psycopg3 ---
# Formato: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://contas:change_me_in_production@localhost:5432/contas

# --- OpenAI API ---
OPENAI_API_KEY=sk-...

# --- Aplicação ---
DEBUG=false
INVOICE_MODEL=o3-mini

# --- Keycloak (Gerenciamento de Usuários / OIDC) ---
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_in_production
KEYCLOAK_SERVER_URL=http://localhost:8180
KEYCLOAK_INTERNAL_URL=
KEYCLOAK_REALM=contas
KEYCLOAK_CLIENT_ID=contas-app
KEYCLOAK_CLIENT_SECRET=contas-keycloak-client-secret
KEYCLOAK_REDIRECT_URI=http://localhost:8501
